---
// Atelier Pyxel : fonctions testées dans le worker Pyodide, puis appelées par le moteur Pyxel.
// Contenu des ateliers : src/data/pyxel/ateliers.ts, indexé par le nom du support Prof.
import { ateliersPyxel } from '../data/pyxel/ateliers';

const { nom } = Astro.props;
const a = ateliersPyxel[nom];
if (!a) throw new Error(`Atelier Pyxel inconnu : ${nom}`);
const moteur = a.moteur;
---

<div class="pyxel">
	<p set:html={a.consigne} />
	<section class="exo-py" data-fichier={`${a.id}.py`}>
		<h2 id={a.id}>{a.titre}</h2>
		<div class="editeur">
			<label for="code-pyxel">Votre code Python</label>
			<textarea id="code-pyxel" spellcheck="false" autocapitalize="off">{a.depart}</textarea>
			<div class="barre">
				<button type="button" data-action="tester">Vérifier les tests</button>
				<button type="button" data-action="indenter">Insérer 4 espaces</button>
				<button type="button" data-action="telecharger">Télécharger mon .py</button>
				<button type="button" data-action="reset">Code de départ</button>
				<button type="button" id="lancer">Lancer le jeu</button>
			</div>
			<pre class="sortie" hidden></pre>
			<div class="resultats" aria-live="polite"></div>
		</div>
		<script class="tests" type="application/json" set:html={JSON.stringify(a.tests)} />
	</section>
	<div class="ecran"><div id="pyxel-screen"></div></div>
	<p class="consigne">{a.commandes}</p>
	<div class="py-etat" id="py-etat" aria-live="polite">Chargement de Python…</div>
	<script is:inline define:vars={{ moteur }}>window.MOTEUR_PYXEL = moteur;</script>
	<script is:inline src="https://cdn.jsdelivr.net/gh/kitao/pyxel@v2.8.7/wasm/pyxel.js"></script>
	<script src="../scripts/binaire.js"></script>
	<script>
		const zone = document.querySelector<HTMLTextAreaElement>('#code-pyxel')!;
		// SDL écoute le clavier sur window : sans ce barrage, les flèches et la frappe dans l'éditeur pilotent le jeu.
		for (const type of ['keydown', 'keyup', 'keypress']) zone.addEventListener(type, (e) => e.stopPropagation());
		let lance = false;
		document.getElementById('lancer')!.addEventListener('click', () => {
			// ponytail: une boucle infinie dans le code élève gèle la page (Pyxel tourne sur le fil principal) ; tester d'abord dans le worker si ça arrive en classe.
			const script = zone.value + '\n' + (window as any).MOTEUR_PYXEL;
			const ctx = (window as any).pyxelContext;
			if (!lance) { lance = true; (window as any).launchPyxel({ command: 'run', script }); }
			else if (ctx.initialized) { ctx.params.script = script; (window as any).resetPyxel(); }
		});
	</script>
	<style>
		.ecran { position: relative; width: min(100%, 512px); aspect-ratio: 1; margin: 1rem auto 0; }
		.consigne { text-align: center; font-size: var(--sl-text-sm); }
	</style>
</div>
