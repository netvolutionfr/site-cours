<section class="sha-calculateur" aria-labelledby="sha-titre">
  <h2 id="sha-titre">Calculer une empreinte SHA-256</h2>
  <p>Choisissez un fichier pour calculer son empreinte. Le fichier reste sur votre appareil.</p>
  <label for="sha-fichier">Fichier à examiner</label>
  <input id="sha-fichier" type="file" />
  <p id="sha-etat" role="status" aria-live="polite">Choisissez un fichier pour commencer.</p>
  <output id="sha-resultat" aria-label="Empreinte SHA-256"></output>
  <p class="sha-note">Pour vérifier l'intégrité, comparez les 64 caractères avec une référence fiable. Une empreinte seule ne prouve pas l'origine.</p>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('#sha-fichier');
  const status = document.querySelector<HTMLElement>('#sha-etat');
  const output = document.querySelector<HTMLOutputElement>('#sha-resultat');
  let current = 0;
  input?.addEventListener('change', async () => {
    if (!status || !output) return;
    const request = ++current;
    output.textContent = '';
    const file = input.files?.[0];
    if (!file) { status.textContent = 'Choisissez un fichier pour commencer.'; return; }
    if (!globalThis.crypto?.subtle) { status.textContent = 'Le calcul est indisponible dans ce navigateur ou sur cette connexion.'; return; }
    if (file.size > 100 * 1024 * 1024) { status.textContent = 'Choisissez un fichier de 100 Mo maximum.'; return; }
    status.textContent = `Calcul en cours : ${file.name}`;
    try {
      const bytes = await file.arrayBuffer();
      const digest = await crypto.subtle.digest('SHA-256', bytes);
      if (request !== current) return;
      output.textContent = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
      status.textContent = `Empreinte SHA-256 de ${file.name} :`;
    } catch {
      if (request === current) status.textContent = 'Impossible de lire ou de calculer ce fichier. Réessayez avec un autre fichier.';
    }
  });
</script>

<style>
  .sha-calculateur { margin-block: 3rem; padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; }
  .sha-calculateur h2 { margin-top: 0; }
  .sha-calculateur label { display: block; font-weight: 600; margin-block: 1rem .5rem; }
  .sha-calculateur input { max-width: 100%; }
  .sha-calculateur output:not(:empty) { display: block; padding: .75rem; background: var(--sl-color-gray-6); font-family: monospace; overflow-wrap: anywhere; user-select: all; }
  .sha-note { font-size: .9rem; }
</style>
