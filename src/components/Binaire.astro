import LireOctet from './LireOctet.astro';
const starters = ["def poids(position):\n    return ...\n\n\nfor position in range(8):\n    print(position, poids(position))\n", "def lire_octet(bits):\n    total = 0\n    poids = 128\n    for bit in bits:\n        if bit == \"1\":\n            total = ...\n        poids = ...\n    return total\n\n\nprint(lire_octet(\"01001101\"))\n", "def ecrire_binaire(n):\n    if n == 0:\n        return ...\n    bits = \"\"\n    while n > 0:\n        bits = ...\n        n = ...\n    return bits\n\n\nprint(ecrire_binaire(13))\n"];
const tests = [["poids(0) == 1", "poids(1) == 2", "poids(2) == 4", "poids(3) == 8", "poids(4) == 16", "poids(5) == 32", "poids(6) == 64", "poids(7) == 128"], ["lire_octet(\"00000000\") == 0", "lire_octet(\"00000001\") == 1", "lire_octet(\"00000010\") == 2", "lire_octet(\"00000100\") == 4", "lire_octet(\"00001000\") == 8", "lire_octet(\"00010000\") == 16", "lire_octet(\"00100000\") == 32", "lire_octet(\"01000000\") == 64", "lire_octet(\"10000000\") == 128", "lire_octet(\"01001101\") == 77", "lire_octet(\"10101100\") == 172", "lire_octet(\"11111111\") == 255"], ["ecrire_binaire(0) == \"0\"", "ecrire_binaire(1) == \"1\"", "ecrire_binaire(2) == \"10\"", "ecrire_binaire(13) == \"1101\"", "ecrire_binaire(57) == \"111001\"", "ecrire_binaire(127) == \"1111111\"", "ecrire_binaire(128) == \"10000000\"", "ecrire_binaire(200) == \"11001000\"", "ecrire_binaire(255) == \"11111111\"", "ecrire_binaire(256) == \"100000000\"", "ecrire_binaire(1000) == \"1111101000\""]];
export const headings = [{"depth": 2, "slug": "machine", "text": "1. Retrouver les poids"}, {"depth": 2, "slug": "conversions", "text": "2. Convertir à la main"}, {"depth": 2, "slug": "capacite", "text": "3. Combien de bits ?"}, {"depth": 2, "slug": "poids", "text": "4. Programmer les poids"}, {"depth": 2, "slug": "lire_octet", "text": "5. Lire un octet avec Python"}, {"depth": 2, "slug": "ecrire_binaire", "text": "6. Défi : convertir par divisions"}, {"depth": 2, "slug": "bilan", "text": "Restitution : expliquer sa machine"}];
