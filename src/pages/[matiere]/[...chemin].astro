---
import type { MarkdownInstance } from 'astro';
import Binaire, { headings as headingsBinaire } from '../../components/Binaire.astro';
import { readFileSync } from 'node:fs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Badge, LinkButton } from '@astrojs/starlight/components';
import { jourFr, lienSupport, parSequence, parSlug, sidebarClasse, supports, variante } from '../../lib/manifeste';

export function getStaticPaths() {
	return supports.map((s) => {
		const [matiere, ...chemin] = s.slug.split('/');
		return { params: { matiere, chemin: chemin.join('/') }, props: { s } };
	});
}

const { s } = Astro.props;
const markdown = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../../contenu/pages/*.md', { eager: true });
if (s.composant && !['Binaire', 'Markdown'].includes(s.composant)) throw new Error(`Composant inconnu : ${s.composant}`);
const page = s.composant === 'Markdown' ? markdown[`../../../contenu/pages/${s.slug.replaceAll('/', '--')}.md`] : undefined;
if (s.composant === 'Markdown' && !page) throw new Error(`Markdown absent : ${s.slug}`);
const Content = page?.Content;
const headings = page ? await page.getHeadings() : s.composant === 'Binaire' ? headingsBinaire : s.titres;
const html = s.composant || s.brut ? '' : readFileSync(`contenu/pages/${s.slug.replaceAll('/', '--')}.html`, 'utf-8');
const seq = parSequence.get(s.sequence);
const voisins = seq?.supports ?? [];
const i = voisins.indexOf(s.slug);
const voisin = (slug?: string) => {
	const v = slug && parSlug.get(slug);
	return v ? { link: lienSupport(v), label: v.titre } : false;
};
---

<StarlightPage
	frontmatter={{
		title: s.titre,
		description: s.sousTitre || undefined,
		prev: voisin(voisins[i - 1]),
		next: voisin(voisins[i + 1]),
	}}
	sidebar={sidebarClasse(s.matiere, s.classe)}
	headings={headings}
>
	<div class="entete-support">
		{s.sousTitre && <p class="sous-titre">{s.sousTitre}</p>}
		<p class="meta">
			<Badge text={s.nature} variant={variante(s.nature)} />
			{s.date && <time datetime={s.date}>{jourFr(s.date, true)}</time>}
			{seq && <a href={`/${s.matiere}/${s.classe}/`}>{seq.titre}</a>}
		</p>
		{(s.pdf || s.pieces.length > 0) && (
			<p class="actions">
				{s.pdf && <LinkButton href={s.pdf} icon="document" variant="secondary">Version PDF</LinkButton>}
				{s.pieces.map((p) => (
					<LinkButton href={p} icon="download" variant="minimal">{p.split('/').pop()}</LinkButton>
				))}
			</p>
		)}
	</div>
	{Content ? <Content /> : s.composant === 'Binaire' ? <Binaire /> : s.brut ? <iframe class="brut" src={s.brut} title={s.titre}></iframe> : <Fragment set:html={html} />}
</StarlightPage>

<script>
	// QCM auto-corrigé (rendu par web.lua côté Prof).
	document.querySelectorAll<HTMLFieldSetElement>('fieldset.qcm').forEach((q) => {
		q.addEventListener('change', (e) => {
			const ok = (e.target as HTMLElement).hasAttribute('data-ok');
			const fb = q.querySelector('.fb')!;
			fb.className = 'fb ' + (ok ? 'ok' : 'ko');
			fb.textContent = ok ? 'Juste.' : 'Pas tout à fait : relisez puis réessayez.';
			const ex = q.querySelector<HTMLElement>('.explication')!;
			if (ex.textContent!.trim()) ex.hidden = !ok;
		});
	});

	// Page autonome : sans son propre cartouche, à la hauteur de son contenu, au thème du site.
	document.querySelectorAll<HTMLIFrameElement>('iframe.brut').forEach((f) => {
		const brancher = () => {
			const d = f.contentDocument;
			if (!d?.body || d.location.href === 'about:blank' || f.dataset.branche) return;
			f.dataset.branche = '1';
			d.querySelector('body > header')?.remove();
			d.querySelector('body > footer')?.remove();
			const theme = () => (d.documentElement.dataset.theme = document.documentElement.dataset.theme);
			theme();
			new MutationObserver(theme).observe(document.documentElement, { attributeFilter: ['data-theme'] });
			const ajuster = () => (f.style.height = `${d.documentElement.scrollHeight}px`);
			new ResizeObserver(ajuster).observe(d.body);
			ajuster();
			// Ancres internes : l'iframe ne défile pas, c'est la page qui doit défiler.
			d.addEventListener('click', (e) => {
				const a = (e.target as Element).closest?.('a[href^="#"]');
				const cible = a && d.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1)));
				if (!cible) return;
				e.preventDefault();
				scrollTo({ top: f.getBoundingClientRect().top + scrollY + cible.getBoundingClientRect().top - 80, behavior: 'smooth' });
			});
		};
		f.addEventListener('load', brancher);
		if (f.contentDocument?.readyState === 'complete') brancher();
	});
</script>
